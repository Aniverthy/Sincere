# Copy to .env and fill in. Never commit real values.
#
# Two layers, per sincere/shared/config.py:
#   - Infrastructure settings (this file's top half) require a redeploy to change.
#   - Product thresholds (bottom half) seed the launch defaults; once overridden through
#     PATCH /admin/config/thresholds the stored value wins, with NO redeploy (§2).

# --- Environment ---
ENVIRONMENT=dev                 # dev | test | staging | production
DEBUG=false
LOG_LEVEL=INFO

# --- Data stores ---
# Production REQUIRES an Atlas connection string (mongodb+srv://): §9 duplicate detection
# depends on Atlas Vector Search, which needs an M10+ cluster. The free M0 tier does not
# support $vectorSearch. Local dev can use the docker-compose replica set below.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=sincere
REDIS_URL=redis://localhost:6379/0

# --- Auth (§5) ---
# Production requires >= 32 characters and rejects anything containing "test" or "dev-only".
JWT_SECRET=
JWT_ACCESS_TTL=900              # 15 min — §5 short-lived access token
JWT_REFRESH_TTL=2592000         # 30 days — matches the FR-2.3 activity window

# --- Object storage (§4 pre-signed uploads) ---
# Leave the bucket blank in dev to fall back to a local filesystem backend.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=ap-south-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_KEY=
OBJECT_STORAGE_SECRET=

# --- Payments (§3: aggregator adapter, vendor TBD) ---
PAYMENT_PROVIDER=sandbox        # sandbox | razorpay
PAYMENT_AGGREGATOR_KEY=
PAYMENT_AGGREGATOR_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- OTP delivery (§17: SMS is OTP-only, never marketing) ---
SMS_PROVIDER=console            # console logs the OTP; use twilio in staging/production
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# --- Feature gates ---
# §9:484 — combined legal review of biometric consent is a HARD BLOCKER before the face
# pipeline may ship. With this false, signups route to human review instead of running
# embeddings. Only set true after legal sign-off.
BIOMETRIC_PIPELINE_ENABLED=false
WEMET_ENABLED=true
PUSH_NOTIFICATIONS_ENABLED=false   # §17: push is DECIDED-deferred to v2

# --- ML (§13) ---
MODEL_REGISTRY_PATH=ml/registry
EMBEDDING_BACKEND=Facenet       # DeepFace config string — §9 keeps this swappable
EMBEDDING_DIMENSIONS=512

# --- Observability (§21) ---
METRICS_ENABLED=true
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Rate limits (§18) ---
RATE_LIMIT_OTP_PER_HOUR=5
RATE_LIMIT_SWIPES_PER_MINUTE=60
RATE_LIMIT_MESSAGES_PER_MINUTE=30
RATE_LIMIT_BIDS_PER_MINUTE=20

# ===========================================================================
# Product thresholds — launch defaults. Every one is tunable at runtime (§2).
# ===========================================================================

# --- Admission & ratio (FR-2) ---
H3_RESOLUTION=6                 # FR-2.1 (DECIDED)
RATIO_UPPER_BAND=1.05           # FR-2.4 (DECIDED) freeze male admissions at this multiple
RATIO_LOWER_BAND=0.95           # FR-2.4 (DECIDED) resume when women recover past this
ADMISSION_BUFFER=0.93           # FR-2.5 (DECIDED) admit men to ~90-95% of active women
QUEUE_SPLIT_FREE=0.60           # FR-2.7 (DECIDED) — the three must sum to exactly 1.0
QUEUE_SPLIT_PAID=0.25
QUEUE_SPLIT_AUCTION=0.15
ACTIVE_WINDOW_DAYS=30           # FR-2.3 (DECIDED)
AUCTION_WINDOW_START_HOUR=19    # FR-2.9 window time is an OPEN item (README.md:361)
AUCTION_WINDOW_END_HOUR=20
PAID_QUEUE_PRICE_PAISE=49900    # FR-2.8 exact price is an OPEN item
AUCTION_MIN_BID_PAISE=10000

# --- Matching (FR-3, §12) ---
DAILY_MATCH_COUNT=15            # FR-3.1 (DECIDED)
DAILY_MATCH_COUNT_BASIC_PRO=30
DAILY_MATCH_COUNT_PRO_PLUS=40
RADIUS_MIN_KM=1                 # FR-3.2 (DECIDED)
RADIUS_MAX_KM=100
GRADUATION_SWIPES=20            # FR-3.4 (DECIDED) — 20+ swipes AND 3+ matches
GRADUATION_MATCHES=3
EXPLORATION_RATE_PRE_GRADUATION=0.40   # FR-3.5 (DECIDED shape)
EXPLORATION_RATE_POST_GRADUATION=0.15
CONFIDENCE_MATURE_SWIPES=200    # N_mature in the §12 confidence curve
CANDIDATE_POOL_CAP=3000         # §19 keeps nightly scoring linear per user

# --- §12 ranking weights. Each group must sum to exactly 1.0. ---
WEIGHT_COLD_PREFERENCE=0.45
WEIGHT_COLD_DEMOGRAPHIC=0.30
WEIGHT_COLD_PROMPT=0.25
WEIGHT_FINAL_RECIPROCITY=0.35
WEIGHT_FINAL_COLLABORATIVE=0.25
WEIGHT_FINAL_PREFERENCE=0.20
WEIGHT_FINAL_ENGAGEMENT=0.10
WEIGHT_FINAL_FRESHNESS=0.05
WEIGHT_FINAL_VISUAL=0.05        # FR-3.6 (DECIDED) FIXED — the app refuses to boot if changed
VISUAL_SIMILARITY_CAP=0.95
VISUAL_SIMILARITY_NEUTRAL=0.5
FRESHNESS_HALFLIFE_DAYS=7.0

# --- Identity (FR-1) ---
DUPLICATE_SIMILARITY_THRESHOLD=0.90   # FR-1.4 (DECIDED) -> human review, NEVER auto-ban
PHOTO_SELFIE_MATCH_THRESHOLD=0.65     # FR-1.5
BOT_RISK_AUTO_APPROVE_BELOW=0.30      # FR-1.6 (DECIDED) 3-band routing
BOT_RISK_AUTO_REJECT_ABOVE=0.80

# --- Anti-abuse (FR-5) ---
DWELL_THRESHOLD_MS=10000        # FR-5.2 (DECIDED) <10s dwell...
DWELL_RATIO=0.70                # ...on >70% of right-swipes
DWELL_WINDOW_SWIPES=100
DWELL_MIN_SWIPES_TO_EVALUATE=25
WARNINGS_BEFORE_BAN=3           # FR-5.3 (DECIDED) on separate occasions
WARNING_SEPARATE_OCCASION_HOURS=24

# --- Chat & We-Met (FR-4) ---
WEMET_TRIGGER_MESSAGES=20       # FR-4.3 (DECIDED) 20-30 messages within a 3-day window
WEMET_TRIGGER_MESSAGES_MAX=30
WEMET_TRIGGER_WINDOW_DAYS=3
WEMET_REASK_DAYS_MIN=7          # FR-4.3 (DECIDED) re-ask every 1-2 weeks
WEMET_REASK_DAYS_MAX=14

# --- Retention (FR-7, §8, §18). All DECIDED, pending legal confirmation. ---
GRACE_PERIOD_DAYS=30
MESSAGE_RETENTION_DAYS_POST_UNMATCH=90
DEVICE_SIGNAL_RETENTION_DAYS=90
VERIFICATION_CAPTURE_RETENTION_DAYS=30
PAYMENT_RECORD_RETENTION_YEARS=7      # §18: survives the account-deletion cascade

# --- Monetization (FR-6) ---
PRO_BASIC_PRICE_PAISE=79900     # FR-6.1 exact pricing is an OPEN item (README.md:361)
PRO_PLUS_PRICE_PAISE=149900
GST_RATE=0.18                   # FR-6.5 place-of-supply split at invoice time
